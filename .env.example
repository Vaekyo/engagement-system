# Copy to .env (or .env.local) and fill in. Never commit real secrets.

# PostgreSQL connection string
DATABASE_URL="postgresql://engage:engage@localhost:5432/engagement?schema=public"

# Public base URL of the app (used for OAuth redirect URIs)
APP_URL="http://localhost:3000"

# 32+ random characters. Signs dashboard sessions and keys audience-ID hashes.
#   openssl rand -base64 48
SESSION_SECRET=""

# 32 random bytes, base64. Encrypts OAuth tokens at rest (AES-256-GCM).
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# Shared secret for the scheduled worker endpoint POST /api/jobs/run
#   openssl rand -base64 32
CRON_SECRET=""

# "true": demo data + mock adapter, no platform calls. Set "false" for real integrations.
MOCK_MODE="true"

# Publishing through official APIs stays off until endpoints, permissions and
# the approval flow are verified. With "false", approved drafts go to the manual
# copy-and-post flow instead.
ENABLE_LIVE_PUBLISHING="false"

# Claude API (runtime AI). Without a key, a deterministic mock generator is used.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# YouTube Data API via Google OAuth (Google Cloud Console → Credentials → OAuth client, type "Web application").
# Authorized redirect URI: ${APP_URL}/api/oauth/youtube/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: password for the seeded demo workspace (default: demo-password-123)
# SEED_PASSWORD=""

# Optional: local worker interval in seconds (npm run worker)
# WORKER_INTERVAL_SECONDS=60
